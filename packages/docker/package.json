{
  "name": "@etherna/docker",
  "version": "1.7.0",
  "description": "Orchestrate Etherna Docker services from Node and CLI",
  "author": "Mattia Dalzocchio",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Etherna/etherna-vite-plugin",
    "directory": "packages/docker"
  },
  "keywords": [
    "etherna",
    "docker"
  ],
  "bugs": {
    "url": "https://etherna.atlassian.net/projects/EVP"
  },
  "homepage": "https://github.com/etherna/etherna-vite-plugin#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "etherna": "dist/bin.cjs"
  },
  "scripts": {
    "build": "pnpm tsdown",
    "test": "pnpm vitest run",
    "typecheck": "pnpm tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "node-forge": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/node-forge": "1.3.14",
    "chalk": "5.6.2",
    "tsdown": "0.22.9",
    "typescript": "6.0.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
